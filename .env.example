# Database. Set DATABASE_URL to run against a real PostgreSQL server (production).
# Leave it unset for local development: `npm run dev` then starts PGlite, an
# embedded Postgres that needs no server — same driver, same dialect, zero setup.
# DATABASE_URL=postgres://spoolhouse:secret@localhost:5432/spoolhouse

# Local development only (ignored when DATABASE_URL is set): directory holding
# the PGlite cluster, and the port it listens on.
# DATABASE_PATH=data/pglite
# DEV_DB_PORT=5433

# Auth (required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (e.g. https://spoolhouse.example.com)
BETTER_AUTH_URL=http://localhost:3000

MINIMUM_PASSWORD_LENGTH=12

# Allow public sign-up (default: false — accounts are then created by an admin
# on /admin/users or via `npm run admin:create`). Requires a server restart.
# ALLOW_SIGNUP=true

# SMTP for password-reset mails (optional — without SMTP_HOST, mails are logged to the server console)
# SMTP_HOST=mail.gmx.net
# SMTP_PORT=587
# SMTP_USER=you@gmx.net
# SMTP_PASS=
# MAIL_FROM="Spoolhouse <you@gmx.net>"
