#pragma once
// Copy to secrets.h (git-ignored) and fill in. secrets.h is required to build.
//
// These are COMPILE-TIME DEFAULTS / fallbacks. At runtime the device prefers
// credentials entered in the WiFi setup portal (and the token/URL saved there).
// Leave WIFI_SSID as the placeholder to always start the setup AP on first boot;
// fill it in to auto-connect without provisioning.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Base URL of the Spoolhouse server (the Docker host's LAN IP). No trailing slash.
#define SPOOLHOUSE_URL "http://192.168.1.197:3000"

// API token from Account -> API tokens (or npm run token:create).
#define SPOOLHOUSE_TOKEN "sph_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// Password required to push OTA (over-the-air) firmware updates. Flash
// wirelessly: pio run -e cyd_ota -t upload --upload-port <ip>
// Also guards the device web page: browser firmware upload and changing the
// server URL / API token ask for user "admin" + this password. Leave "" for
// no OTA password — browser firmware upload is then disabled entirely.
#define OTA_PASSWORD "change-me-ota"
