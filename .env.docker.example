# Copy to .env.docker (git-ignored) and fill in. Used by docker-compose.yml.

# Required: a long random secret for better-auth session signing.
#   generate: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme-generate-a-long-random-secret

# The URL the app is reached at. For LAN/device access use the host's LAN IP
# (e.g. what the ESP32 will connect to), not localhost.
BETTER_AUTH_URL=http://192.168.1.197:3000

# Extra origins allowed to call the auth API (comma-separated), for when the
# app is opened via several hosts. Otherwise logging in from one gives
# "Invalid origin". BETTER_AUTH_URL is always trusted.
TRUSTED_ORIGINS=http://localhost:3000,http://192.168.1.197:3000

# SQLite file inside the container (persisted via the spoolhouse-data volume).
DATABASE_PATH=/data/spoolhouse.db

# Set true to allow public self-registration; otherwise admins create users.
ALLOW_SIGNUP=false
